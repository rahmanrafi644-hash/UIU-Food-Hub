# UIU Food HUB - Environment Configuration
# Copy this file to .env.local and fill in the values:

# 1. Supabase Backend (Auth, Database, Realtime)
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Modern Supabase projects also provide a publishable key (sb_publishable_...):
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 2. Google Gemini API (AI Demand Assistant)
# Obtain a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
